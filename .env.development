# Phase A: the app talks to its own mock routes (app/api/mock/…).
# Real backend: in .env.development.local set NEXT_PUBLIC_API_BASE_URL= (empty),
# BACKEND_URL=http://localhost:8000 and ENABLE_MOCK_API= (README).
NEXT_PUBLIC_API_BASE_URL=/api/mock
ENABLE_MOCK_API=1
# mentee | guest — skips real sign-in in local dev (unset it to use Supabase).
NEXT_PUBLIC_MOCK_VIEWER=mentee
# External Cal link for "Find my mentor matches" — empty hides the prompt. Ask product for the URL.
NEXT_PUBLIC_MATCH_CALL_URL=
# Mentee onboarding (/onboarding): on in local dev and CI review, off until set per deployed env.
NEXT_PUBLIC_ONBOARDING_ENABLED=true
# Messages (/messages, the nav item, Message buttons): on in local dev and CI review, off until set per deployed env.
NEXT_PUBLIC_MESSAGES_ENABLED=true
# Tours on Home (What's new for migrated accounts, the Welcome tour for new ones): on in local dev and CI review, off until set per deployed env.
NEXT_PUBLIC_WHATS_NEW_ENABLED=true
# Opt in to see one with the mock viewers, nothing seen: 1 = migrated (What's new), new = made here (Welcome tour).
# Off so /home and /dashboard reviews aren't covered.
# NEXT_PUBLIC_MOCK_TOUR=1
NEXT_PUBLIC_ADMIN_EMAILS_ENABLED=true
