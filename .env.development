# Phase A: the app talks to its own mock routes (app/api/mock/…).
# To use the real backend: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000 and unset ENABLE_MOCK_API.
NEXT_PUBLIC_API_BASE_URL=/api/mock
ENABLE_MOCK_API=1
# mentee | guest — auth is not wired yet (phase B).
NEXT_PUBLIC_MOCK_VIEWER=mentee
# External Cal link for "Find my mentor matches" — empty hides the prompt. Ask product for the URL.
NEXT_PUBLIC_MATCH_CALL_URL=
