# Empty = same origin: /api/v1/… is proxied to BACKEND_URL (next.config.ts). /api/mock = mock.
NEXT_PUBLIC_API_BASE_URL=
# Server-only. Where the proxy forwards /api/v1/…; https except localhost. Required on Vercel.
BACKEND_URL=http://localhost:8000
# Set to 1 to serve the phase A mock API from app/api/mock (dev and page review only).
ENABLE_MOCK_API=
# mentee | guest (phase A only; replaced by real auth)
NEXT_PUBLIC_MOCK_VIEWER=mentee
# "Find my mentor matches" — TEMPORARY external Cal booking page (product, 2026-09-26).
# Empty → the match prompt is not rendered. Matching moves onto the platform later.
NEXT_PUBLIC_MATCH_CALL_URL=
# Where a declined mentor's "Contact support" link goes (design reply #42). Empty →
# the words show without a link until a support page exists.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Supabase (passwordless sign-in). Both public by design. Empty → auth off (guest / mock viewer).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mentee Onboarding v5. "true" → new mentees go to /onboarding after sign-up; anything
# else → straight back to their booking, or /home. Off until the onboarding backend ships.
NEXT_PUBLIC_ONBOARDING_V5_ENABLED=
# Mentor onboarding (/onboarding/mentor, /mentor-application). "true" → new mentors and
# not-approved mentors go there after sign-in; anything else → /home and /dashboard.
NEXT_PUBLIC_MENTOR_ONBOARDING_ENABLED=
