{
  "name": "edufurther-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi/openapi.json -o src/lib/api/generated/schema.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:private": "node scripts/check-private-paths.mjs"
  },
  "checkBoundaries": {
    "root": "src",
    "clientModules": [
      "lib/api/generated"
    ],
    "ignore": [
      "**/*.stories.tsx",
      "**/*.test.tsx",
      "**/*.test.ts"
    ]
  },
  "reviewPage": {
    "widths": [
      390,
      1440
    ],
    "outDir": ".review",
    "budgets": {
      "lcpMs": 2500,
      "cls": 0.1,
      "jsKb": 350,
      "totalKb": 1200
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.3",
    "next": "^16.3.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
