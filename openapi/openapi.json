{
  "openapi": "3.1.0",
  "info": {
    "title": "EduFurther API (PROVISIONAL SUBSET)",
    "version": "0.0.0-provisional",
    "description": "Hand-written from edufurtherBE src/app/api/schemas/mentors.py and the backend's handoff reply (docs/handoff/explore-backend-reply.md), 2026-09-26, because the live spec could not be exported. REPLACE with the real /openapi.json and run `pnpm gen:api` once feat/mentors-offering-filter merges. Revised for backend reply v2: offering is ANY-of; next_available_at and total are mocked ahead of the backend. SWAP RULE (backend, 2026-09-26): at the filter merge take only the offering param from the real spec; keep total and next_available_at here until the backend confirms each has landed (total first, then next_available_at)."
  },
  "paths": {
    "/api/v1/mentors": {
      "get": {
        "operationId": "find_mentors",
        "summary": "Find a mentor",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offering",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 60
              },
              "maxItems": 10
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_MentorSummaryRead_"
                }
              }
            }
          },
          "422": {
            "description": "Unknown offering, or a cursor this endpoint did not issue",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/service-offerings": {
      "get": {
        "operationId": "list_service_offerings",
        "summary": "The service-offering taxonomy, in display order",
        "responses": {
          "200": {
            "description": "Whole list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_LookupRead_"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServiceOfferingRead": {
        "type": "object",
        "required": [
          "slug",
          "display_name"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "MentorSummaryRead": {
        "type": "object",
        "required": [
          "id",
          "completed_sessions",
          "review_count",
          "offerings"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "headline": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_study_country": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin_country": {
            "type": [
              "string",
              "null"
            ]
          },
          "degree": {
            "type": [
              "string",
              "null"
            ]
          },
          "study_course": {
            "type": [
              "string",
              "null"
            ]
          },
          "institution": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_sessions": {
            "type": "integer"
          },
          "review_count": {
            "type": "integer"
          },
          "session_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "offerings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceOfferingRead"
            }
          },
          "next_available_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Next free slot (UTC). Null = none within the booking horizon. COMING (backend reply #4)."
          }
        }
      },
      "Page_MentorSummaryRead_": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MentorSummaryRead"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "integer",
            "description": "First page only (no cursor). COMING (backend reply #7)."
          }
        }
      },
      "LookupRead": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Page_LookupRead_": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LookupRead"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
