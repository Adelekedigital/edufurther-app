{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm spec:pull && pnpm gen:api && pnpm build",
  "skipMiddlewareRequestBody": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "development": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore.mjs"
}
